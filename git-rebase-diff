#!/bin/sh

set -e

# TODO:
#
# 1. --left max should become default behavior
# except that we list only the versions of this branch, and it's summaries (1 line per version/reroll)
#
#
#

main() {
	NTH=0
	LEFT=0
	RIGHT=0
	MODE=""  # "", "aggregate", or "final"
	GIT_REBASE_DIFF_NOEXEC=${GIT_REBASE_DIFF_NOEXEC:-0}

	while test $# -gt 0; do
		case $1 in
		-x|--nth)
			shift
			NTH="$1"
			shift
			test "$NTH" == "max" && NTH="$(get_max_entry)"
			;;
		-l|--left)
			shift
			LEFT="$1"
			shift
			test "$LEFT" == "max" && LEFT="$(get_max_entry)"
			;;
		-r|--right)
			shift
			RIGHT="$1"
			shift
			;;

		-a|--aggregate)
			shift
			MODE="aggregate"
			;;

		-aa|-A|--aggregate-absolute)
			shift
			MODE="aggregate-absolute"
			;;

		-d|--debug)
			shift
			DEBUG=1
			;;
		--)
			shift
			break
			;;

		# extras for NTH
		-max)
			shift
			NTH="$(get_max_entry)"
			;;
		-*)
			NTH="$(printf "%s" "$1" | cut -d- -f2)"
			shift
			;;
		*)
			>&2 printf "unknown option %s; use -- to forward args to range-diff.\n" $1
			exit 1
			;;
		esac
	done

	test $NTH -ne 0 && {
		BAD=0
		test $LEFT  -ne 0 && BAD=1
		test $RIGHT -ne 0 && BAD=1

		test $BAD -ne 0 && {
			>&2 printf "option --nth cannot be used with --left, --right.\n"
			exit 1
		}

		LEFT=$NTH
		RIGHT=$NTH
	}

	COUNT=$(( LEFT - RIGHT + 1 ))

	nth=$LEFT
	while test $nth -ge $RIGHT; do
		git_rebase_diff $nth $COUNT "$MODE" "$@"
		nth=$(( nth - 1 ))
	done

	exit 0
}

git_rebase_diff() {
	nth=$1
	shift
	count=$1
	shift
	mode=$1
	shift

	OLD_HEAD="@{u}@{$nth}"
	NEW_HEAD="@{u}@{$(( nth - 1 ))}"
	test $nth -eq 0 && {
		NEW_HEAD="@"
	}

	rOLD="$(git rev-parse $OLD_HEAD 2>&1)" || {
		# log does not have as many entries. re-print the error:
		>&2 printf "%s\n" "$rOLD"
		return 1
	}
	rNEW=$(git rev-parse "$NEW_HEAD")

	OLD_HEAD_EQUALS_NEW_HEAD=0
	test "$rOLD" == "$rNEW" && OLD_HEAD_EQUALS_NEW_HEAD=1

	MERGE_BASE="$(git merge-base "$OLD_HEAD" "$NEW_HEAD")"

	test -n "$DEBUG" || test $count -gt 1 && {
		>&2 printf "comparing %s %s %s (%s %s):\n" \
			"$MERGE_BASE" "$OLD_HEAD" "$NEW_HEAD" "$(git rev-parse ${OLD_HEAD})" "$(git rev-parse ${NEW_HEAD})"
	}

	if test "$OLD_HEAD_EQUALS_NEW_HEAD" -eq 1; then
		extra=""
		test $count -eq 1 && extra=". try:\ngit-rebase-diff -x,--nth <number>"
		>&2 printf "\$old == \$new, nothing to do${extra}\n"
	fi

	test "$GIT_REBASE_DIFF_NOEXEC" -eq 0 && {
		case "$mode" in
		aggregate)
			# Show diff-of-diffs (what changed between rebases)
			PAGER_CMD=$(get_simple_pager)
			USE_COLOR=0
			should_use_color && USE_COLOR=1
			export USE_COLOR
			git_rebase_diff_aggregate "$MERGE_BASE" "$OLD_HEAD" "$NEW_HEAD" | $PAGER_CMD
			;;
		aggregate-absolute)
			# Show absolute diff (single +/- markers instead of double)
			PAGER_CMD=$(get_simple_pager)
			USE_COLOR=0
			should_use_color && USE_COLOR=1
			export USE_COLOR
			git_rebase_diff_absolute "$MERGE_BASE" "$OLD_HEAD" "$NEW_HEAD" | $PAGER_CMD
			;;
		*)
			# Default: range-diff
			git range-diff "$MERGE_BASE" "$OLD_HEAD" "$NEW_HEAD" "$@"
			;;
		esac
		test "$count" -gt 1 && printf "\n"
	}

	return 0
}

git_rebase_diff_aggregate() {
	old_base=$1
	old_head=$2
	new_head=$3
	
	# Find NEW_BASE: use the most appropriate base for the new head
	new_base=$(get_new_base "$new_head" "$old_head")

	test -n "$DEBUG" && {
		old_count=$(git rev-list --count "$old_base".."$old_head")
		new_count=$(git rev-list --count "$new_base".."$new_head")
		>&2 printf "aggregate: OLD_BASE=%s NEW_BASE=%s (old_commits=%s new_commits=%s)\n" \
			"$old_base" "$new_base" "$old_count" "$new_count"
	}

	TMPDIR="${TMPDIR:-/tmp}"
	OLD_PATCH="$TMPDIR/git-rebase-diff-old.$$"
	NEW_PATCH="$TMPDIR/git-rebase-diff-new.$$"
	trap "rm -f '$OLD_PATCH' '$NEW_PATCH'" EXIT

	files=$(git diff --name-only "$old_base" "$old_head")
	found_diff=0

	# Use color from parent (checked before pipe)
	use_color=${USE_COLOR:-0}

	for f in $files; do
		# Compare only ADDED lines (^+), not removed lines (^-)
		# because the base content differs between old and new
		old_adds=$(git diff "$old_base" "$old_head" -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++" | sort)
		new_adds=$(git diff "$new_base" "$new_head" -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++" | sort)

		if test "$old_adds" != "$new_adds"; then
			found_diff=1
			git diff "$old_base" "$old_head" -- "$f" > "$OLD_PATCH"
			git diff "$new_base" "$new_head" -- "$f" > "$NEW_PATCH"
			# Filter noise first, then colorize
			clean_diff=$(diff -u "$OLD_PATCH" "$NEW_PATCH" 2>/dev/null | filter_aggregate_diff "$f" "$use_color" || true)
			test -n "$clean_diff" && printf "%s\n\n" "$clean_diff"
		fi
	done

	test "$found_diff" -eq 0 && {
		>&2 printf "no differences found - rebase was clean.\n"
	}
}

# Show absolute diff (what changed between rebases, with single +/- markers)
# Same logic as aggregate, but cleaner output without double operators
git_rebase_diff_absolute() {
	old_base=$1
	old_head=$2
	new_head=$3
	
	# Find NEW_BASE: use the most appropriate base for the new head
	new_base=$(get_new_base "$new_head" "$old_head")

	test -n "$DEBUG" && {
		>&2 printf "absolute: OLD_BASE=%s NEW_BASE=%s\n" "$old_base" "$new_base"
	}

	TMPDIR="${TMPDIR:-/tmp}"
	OLD_PATCH="$TMPDIR/git-rebase-diff-old.$$"
	NEW_PATCH="$TMPDIR/git-rebase-diff-new.$$"
	trap "rm -f '$OLD_PATCH' '$NEW_PATCH'" EXIT

	files=$(git diff --name-only "$old_base" "$old_head")
	found_diff=0

	# Use color from parent (checked before pipe)
	use_color=${USE_COLOR:-0}

	for f in $files; do
		old_adds=$(git diff "$old_base" "$old_head" -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++" | sort)
		new_adds=$(git diff "$new_base" "$new_head" -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++" | sort)

		if test "$old_adds" != "$new_adds"; then
			found_diff=1
			git diff "$old_base" "$old_head" -- "$f" > "$OLD_PATCH"
			git diff "$new_base" "$new_head" -- "$f" > "$NEW_PATCH"
			# Same as aggregate, but strip to single operators
			clean_diff=$(diff -u "$OLD_PATCH" "$NEW_PATCH" 2>/dev/null | filter_absolute_diff "$f" "$use_color" || true)
			test -n "$clean_diff" && printf "%s\n\n" "$clean_diff"
		fi
	done

	test "$found_diff" -eq 0 && {
		>&2 printf "no differences found - rebase was clean.\n"
	}
}

# Filter diff-of-diffs output to show only meaningful content
# Args: $1 = filename, $2 = use_color (1 or 0)
filter_aggregate_diff() {
	filename=$1
	use_color=${2:-0}
	awk -v fname="$filename" -v color="$use_color" '
	BEGIN {
		header_printed = 0
		pending_hunk = ""
		CTX = 1  # Context lines around changes
		ctx_idx = 0
		ctx_len = 0
		after_change = 0
		had_output = 0
		if (color) {
			RESET = "\033[0m"
			BOLD = "\033[1m"
			RED = "\033[31m"
			GREEN = "\033[32m"
			YELLOW = "\033[33m"
			CYAN = "\033[36m"
			DIM = "\033[2m"
		} else {
			RESET = BOLD = RED = GREEN = YELLOW = CYAN = DIM = ""
		}
	}
	
	# Skip outer diff headers
	/^--- \// { next }
	/^\+\+\+ \// { next }
	/^@@ .* @@$/ { next }
	
	# Skip inner diff metadata
	/^[-+ ]?diff --git / { next }
	/^[-+ ]?index [0-9a-f]/ { next }
	/^[-+ ]?--- a\// { next }
	/^[-+ ]?\+\+\+ b\// { next }
	
	# Handle @@ hunk headers
	/^[-+ ]?@@ / {
		line = $0
		line_num = ""
		while (match(line, /\+[0-9]+/)) {
			line_num = substr(line, RSTART+1, RLENGTH-1)
			line = substr(line, RSTART + RLENGTH)
		}
		if (line_num != "") pending_hunk = line_num
		ctx_idx = 0
		ctx_len = 0
		after_change = 0
		next
	}
	
	function flush_hunk() {
		if (pending_hunk == "") return
		if (!header_printed) {
			printf "%s%s=== %s:%s ===%s\n", BOLD, YELLOW, fname, pending_hunk, RESET
			header_printed = 1
		} else if (had_output) {
			printf "%s...%s\n", DIM, RESET
		}
		pending_hunk = ""
	}
	
	function flush_context() {
		if (ctx_len == 0) return
		start = ctx_len <= CTX ? 0 : ctx_len - CTX
		for (i = start; i < ctx_len; i++) {
			idx = (ctx_idx - ctx_len + i + CTX * 2) % (CTX * 2)
			if (idx < 0) idx += CTX * 2
			printf "%s%s%s\n", DIM, ctx_ring[idx], RESET
		}
		ctx_len = 0
		ctx_idx = 0
	}
	
	# REAL changes: outer +/- AND inner +/- (double operators)
	# Color based on effective action (same logic as absolute mode)
	/^(\+\+|\+\-|\-\+|\-\-)/ {
		flush_hunk()
		flush_context()
		after_change = CTX
		had_output = 1
		outer = substr($0, 1, 1)
		inner = substr($0, 2, 1)
		# Effective operator: outer + = use inner; outer - = flip inner
		if (outer == "+") {
			op = inner
		} else {
			op = (inner == "+") ? "-" : "+"
		}
		if (op == "-") {
			printf "%s%s%s\n", RED, $0, RESET
		} else {
			printf "%s%s%s\n", GREEN, $0, RESET
		}
		next
	}
	
	# Hunk boundary changes (outer +/- but inner context): skip
	/^[-+] / { next }
	
	# Inner diff context that didnt change ( + or  - or   )
	# Only keep as minimal context around real changes
	{
		if (after_change > 0) {
			flush_hunk()
			# Only show inner +/- context, skip pure whitespace context
			if (/^ [-+]/) {
				printf "%s%s%s\n", DIM, $0, RESET
				had_output = 1
			}
			after_change--
			next
		}
		# Buffer context (only inner +/- lines, not pure context)
		if (/^ [-+]/) {
			ctx_ring[ctx_idx] = $0
			ctx_idx = (ctx_idx + 1) % (CTX * 2)
			if (ctx_len < CTX * 2) ctx_len++
		}
	}
	'
}

# Filter diff-of-diffs to single operators (absolute view)
# Args: $1 = filename, $2 = use_color (1 or 0)
filter_absolute_diff() {
	filename=$1
	use_color=${2:-0}
	awk -v fname="$filename" -v color="$use_color" '
	BEGIN {
		header_printed = 0
		pending_hunk = ""
		CTX = 1
		ctx_idx = 0
		ctx_len = 0
		after_change = 0
		had_output = 0
		if (color) {
			RESET = "\033[0m"
			BOLD = "\033[1m"
			RED = "\033[31m"
			GREEN = "\033[32m"
			YELLOW = "\033[33m"
			CYAN = "\033[36m"
			DIM = "\033[2m"
		} else {
			RESET = BOLD = RED = GREEN = YELLOW = CYAN = DIM = ""
		}
	}
	
	# Skip outer diff headers
	/^--- \// { next }
	/^\+\+\+ \// { next }
	/^@@ .* @@$/ { next }
	
	# Skip inner diff metadata
	/^[-+ ]?diff --git / { next }
	/^[-+ ]?index [0-9a-f]/ { next }
	/^[-+ ]?--- a\// { next }
	/^[-+ ]?\+\+\+ b\// { next }
	
	# Handle @@ hunk headers
	/^[-+ ]?@@ / {
		line = $0
		line_num = ""
		while (match(line, /\+[0-9]+/)) {
			line_num = substr(line, RSTART+1, RLENGTH-1)
			line = substr(line, RSTART + RLENGTH)
		}
		if (line_num != "") pending_hunk = line_num
		ctx_idx = 0
		ctx_len = 0
		after_change = 0
		next
	}
	
	function flush_hunk() {
		if (pending_hunk == "") return
		if (!header_printed) {
			printf "%s%s=== %s:%s ===%s\n", BOLD, YELLOW, fname, pending_hunk, RESET
			header_printed = 1
		} else if (had_output) {
			printf "%s...%s\n", DIM, RESET
		}
		pending_hunk = ""
	}
	
	function flush_context() {
		if (ctx_len == 0) return
		start = ctx_len <= CTX ? 0 : ctx_len - CTX
		for (i = start; i < ctx_len; i++) {
			idx = (ctx_idx - ctx_len + i + CTX * 2) % (CTX * 2)
			if (idx < 0) idx += CTX * 2
			printf "%s%s%s\n", DIM, ctx_ring[idx], RESET
		}
		ctx_len = 0
		ctx_idx = 0
	}
	
	# REAL changes: outer +/- AND inner +/- (double operators)
	# Determine final operator based on what the new patch does
	# outer + = in new patch: use inner as-is
	# outer - = in old patch only: flip inner (we no longer do this)
	/^(\+\+|\+\-|\-\+|\-\-)/ {
		flush_hunk()
		flush_context()
		after_change = CTX
		had_output = 1
		outer = substr($0, 1, 1)
		inner = substr($0, 2, 1)
		content = substr($0, 3)
		
		# Determine effective operator
		if (outer == "+") {
			# In new patch: use inner directly
			op = inner
		} else {
			# In old patch only: flip inner (no longer doing this action)
			op = (inner == "+") ? "-" : "+"
		}
		
		if (op == "-") {
			printf "%s-%s%s\n", RED, content, RESET
		} else {
			printf "%s+%s%s\n", GREEN, content, RESET
		}
		next
	}
	
	# Hunk boundary changes: skip
	/^[-+] / { next }
	
	# Context: show as plain text (no +/- prefix) around real changes
	{
		if (after_change > 0) {
			flush_hunk()
			if (/^ [-+]/) {
				# Context: strip both outer space and inner +/-, show plain content
				printf "%s %s%s\n", DIM, substr($0, 3), RESET
				had_output = 1
			}
			after_change--
			next
		}
		if (/^ [-+]/) {
			ctx_ring[ctx_idx] = " " substr($0, 3)  # Store as plain content with space prefix
			ctx_idx = (ctx_idx + 1) % (CTX * 2)
			if (ctx_len < CTX * 2) ctx_len++
		}
	}
	'
}

# Check if we should use color output
should_use_color() {
	test -t 1 || return 1
	test -n "$NO_COLOR" && return 1
	test "$TERM" = "dumb" && return 1
	return 0
}

get_pager() {
	if test -n "$GIT_PAGER"; then
		printf "%s" "$GIT_PAGER"
	elif git config core.pager >/dev/null 2>&1; then
		git config core.pager
	elif test -n "$PAGER"; then
		printf "%s" "$PAGER"
	else
		printf "cat"
	fi
}

# Simple pager that doesn't mangle diff output (no diff-so-fancy)
get_simple_pager() {
	# Check if stdout is a terminal
	test -t 1 || { printf "cat"; return; }
	
	# Use less with color support if available
	command -v less >/dev/null 2>&1 && {
		printf "less -RFX"
		return
	}
	
	printf "cat"
}

# Get the new base for comparing patches after rebase
# Tries multiple strategies and uses the most recent (best) base
get_new_base() {
	head_ref=$1
	old_head=$2  # Optional: the old head to compare against
	
	# Strategy 1: parent of first rebased commit (original approach)
	if test -n "$old_head"; then
		first_rebased=$(git rev-list "$old_head".."$head_ref" 2>/dev/null | tail -1)
		if test -n "$first_rebased"; then
			base1=$(git rev-parse "$first_rebased^" 2>/dev/null)
		fi
	fi
	
	# Strategy 2: merge-base with main/master
	main_branch=""
	if git rev-parse --verify main >/dev/null 2>&1; then
		main_branch="main"
	elif git rev-parse --verify master >/dev/null 2>&1; then
		main_branch="master"
	elif git rev-parse --verify origin/main >/dev/null 2>&1; then
		main_branch="origin/main"
	elif git rev-parse --verify origin/master >/dev/null 2>&1; then
		main_branch="origin/master"
	fi
	
	if test -n "$main_branch"; then
		base2=$(git merge-base "$head_ref" "$main_branch" 2>/dev/null)
	fi
	
	# Use the MORE RECENT base (the one that's an ancestor of the other, or equal)
	# This handles both scenarios correctly
	if test -n "$base1" && test -n "$base2"; then
		# Check if base2 is ancestor of base1 (base2 is older)
		if git merge-base --is-ancestor "$base2" "$base1" 2>/dev/null; then
			printf "%s" "$base1"
		else
			printf "%s" "$base2"
		fi
	elif test -n "$base2"; then
		printf "%s" "$base2"
	elif test -n "$base1"; then
		printf "%s" "$base1"
	else
		# Last resort fallback
		git merge-base "$head_ref" "@{u}" 2>/dev/null || git rev-parse "$head_ref^"
	fi
}

get_max_entry() {
	MAX_ENTRY="$(git rev-parse "@{u}@{1234567}" 2>&1 | sed -E "s/fatal: log for '[^']+' only has ([0-9]+) entries/\1/")"
	MAX_ENTRY=$(( MAX_ENTRY - 1 ))
	printf "$MAX_ENTRY"
}

main $*
